# ResuAlign Configuration
# Copy this file to .env and fill in your values.

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# For OpenRouter:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-xxx
# OPENROUTER_MODEL=anthropic/claude-3-sonnet

# For local Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b

# App runtime settings
# RESUALIGN_PERSONAL_MODE=1
# RESUALIGN_JOB_DB=data/jobs.db
# RESUALIGN_DATA_DIR=data
# RESUALIGN_WORKER_CONCURRENCY=1   # parallel analysis jobs (1..4; 1 = serial)
# RESUALIGN_LOG_SAMPLE_RATE=0.01   # http.request log sampling (0..1)
# RESUALIGN_HOST=127.0.0.1
# RESUALIGN_PORT=8000

# --- Operations -----------------------------------------------------------
# Backup: scripts/backup.ps1 (Windows) / scripts/backup.sh (macOS/Linux) use
# the sqlite3 online .backup() API into <DataDir>/backups/ (daily kept 7 days,
# 1st-of-month "weekly" kept 30 days). See docs/backup-restore.md.
# Restore drill, cache cleanup and WAL notes: docs/operations.md.
# LAN/public deployment requirements (personal mode is anonymous!):
# docs/deployment-security.md. Do NOT start uvicorn with --workers > 1.
